<resources>
    <string name="app_name">CoreSMS</string>

    <string name="setup_default_title">Make CoreSMS your SMS app</string>
    <string name="setup_default_body">Android only lets one app send and receive texts. CoreSMS needs to be that app to work.</string>
    <string name="setup_default_button">Set as default SMS app</string>

    <string name="setup_blocked_title">Android blocked the change</string>
    <string name="setup_blocked_body">Apps installed outside an app store need one extra step. Open App info, tap the ⋮ menu, choose \"Allow restricted settings\", then come back and try again.</string>
    <string name="setup_blocked_button">Open App info</string>

    <string name="setup_permissions_title">Allow access</string>
    <string name="setup_permissions_body">CoreSMS needs to read your texts and contacts, know which SIM you use, and show notifications.</string>
    <string name="setup_permissions_button">Allow</string>

    <string name="early_build_title">Early build</string>
    <string name="early_build_body">This version sends and receives plain texts. It can\'t download picture or group messages (MMS) yet. Any that arrive are saved so they can be downloaded once that\'s built, if the carrier still has them. Keep your usual messaging app as the default for everyday use.</string>
    <plurals name="saved_mms_notices">
        <item quantity="one">%d MMS message saved for later</item>
        <item quantity="other">%d MMS messages saved for later</item>
    </plurals>

